@tailwind base;
@tailwind components;
@tailwind utilities;

/* ═══════════════════════════════════════════════════════════════════════════
   CYAN OCEAN DESIGN SYSTEM - Water Element (Mệnh Thủy)
   Bí ẩn, Hiện đại, Sâu sắc
   ═══════════════════════════════════════════════════════════════════════════ */

:root {
  /* ─────────────────────────────────────────────────────────────────────────
     COLOR PALETTE: Cyan & Ocean
     ───────────────────────────────────────────────────────────────────────── */
  
  /* Cyan Colors - Primary Theme */
  --color-cyan-primary: #06B6D4;  /* Cyan 500 */
  --color-cyan-light: #67E8F9;    /* Cyan 300 */
  --color-cyan-dark: #0891B2;     /* Cyan 600 */
  --color-cyan-pale: #CFFAFE;     /* Cyan 100 */
  
  /* Ocean Colors - Secondary */
  --color-ocean: #0EA5E9;         /* Sky 500 */
  --color-sky: #38BDF8;           /* Sky 400 */
  --color-deep: #0369A1;          /* Sky 700 */
  --color-mid-night: #0C4A6E;     /* Sky 900 */
  
  /* Background Layers - Deep Ocean */
  --bg-primary: #050C16;          /* Deepest Dark */
  --bg-secondary: #0A1628;        /* Deep Dark */
  --bg-tertiary: #122540;         /* Mid Dark */
  --bg-elevated: #183050;         /* Elevated Dark */
  
  /* Text Colors */
  --text-primary: #E2E8F0;        /* Slate 200 */
  --text-secondary: #94A3B8;      /* Slate 400 */
  --text-muted: #64748B;          /* Slate 500 */
  --text-accent: #22D3EE;         /* Cyan 400 */
  
  /* Borders & Lines */
  --border-subtle: rgba(6, 182, 212, 0.1);
  --border-default: rgba(6, 182, 212, 0.2);
  --border-strong: rgba(6, 182, 212, 0.35);
  
  /* Shadows */
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.5);
  --shadow-glow-cyan: 0 0 40px rgba(6, 182, 212, 0.3);
  --shadow-glow-ocean: 0 0 40px rgba(14, 165, 233, 0.3);
  
  /* Gradients */
  --gradient-nature: linear-gradient(135deg, var(--color-cyan-primary) 0%, var(--color-ocean) 100%);
  --gradient-cyan: linear-gradient(135deg, var(--color-cyan-dark) 0%, var(--color-cyan-light) 100%);
  --gradient-water: linear-gradient(135deg, var(--color-deep) 0%, var(--color-sky) 100%);
  --gradient-pale: linear-gradient(135deg, var(--color-cyan-pale) 0%, var(--color-cyan-light) 100%);
  --gradient-bg: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
  
  /* Timing */
  --transition-fast: 150ms ease;
  --transition-base: 250ms ease;
  --transition-slow: 400ms ease;
  --transition-spring: 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ─────────────────────────────────────────────────────────────────────────────
   BASE STYLES
   ───────────────────────────────────────────────────────────────────────── */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  color: var(--text-primary);
  background: var(--bg-primary);
  font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Selection styling */
::selection {
  background: var(--color-cyan-primary);
  color: #fff;
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-secondary);
}

::-webkit-scrollbar-thumb {
  background: var(--bg-elevated);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--color-cyan-primary);
}

/* ─────────────────────────────────────────────────────────────────────────────
   UTILITY CLASSES
   ───────────────────────────────────────────────────────────────────────── */

/* Gradient Text */
.text-gradient-nature {
  background: var(--gradient-nature);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.text-gradient-cyan {
  background: var(--gradient-cyan);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.text-gradient-water {
  background: var(--gradient-water);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Glass Effect */
.glass {
  background: rgba(10, 22, 40, 0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--border-subtle);
}

.glass-cyan {
  background: rgba(6, 182, 212, 0.08);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(6, 182, 212, 0.2);
}

/* Glow Effects */
.glow-cyan {
  box-shadow: var(--shadow-glow-cyan);
}

.glow-ocean {
  box-shadow: var(--shadow-glow-ocean);
}

/* Noise Texture Overlay */
.noise-overlay::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  opacity: 0.03;
  pointer-events: none;
  z-index: 1;
}

/* Animated Gradient Border */
.gradient-border {
  position: relative;
}

.gradient-border::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 2px;
  background: var(--gradient-nature);
  border-radius: inherit;
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask-composite: xor;
  -webkit-mask-composite: xor;
}

/* Hover Lift Effect */
.hover-lift {
  transition: transform var(--transition-base), box-shadow var(--transition-base);
}

.hover-lift:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

/* Subtle pulse animation */
@keyframes pulse-cyan {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.4);
  }
  50% {
    box-shadow: 0 0 20px 10px rgba(6, 182, 212, 0);
  }
}

.pulse-cyan {
  animation: pulse-cyan 2s ease-in-out infinite;
}

/* Shimmer effect */
@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

.shimmer {
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.1) 50%,
    transparent 100%
  );
  background-size: 200% 100%;
  animation: shimmer 3s ease-in-out infinite;
}

/* Fade in animation */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in {
  animation: fadeIn 0.6s ease-out forwards;
}

/* Staggered children animation */
.stagger-children > * {
  opacity: 0;
  animation: fadeIn 0.5s ease-out forwards;
}

.stagger-children > *:nth-child(1) { animation-delay: 0.1s; }
.stagger-children > *:nth-child(2) { animation-delay: 0.2s; }
.stagger-children > *:nth-child(3) { animation-delay: 0.3s; }
.stagger-children > *:nth-child(4) { animation-delay: 0.4s; }
.stagger-children > *:nth-child(5) { animation-delay: 0.5s; }
.stagger-children > *:nth-child(6) { animation-delay: 0.6s; }
